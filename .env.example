# Copy to .env and fill in real values before running `docker compose up`.

# --- Shogun ---
SHOGUN_DEBUG=true
SHOGUN_PORT=7007
ENABLE_API_SPEC=true

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

JWT_SECRET=change-me
JWT_EXPIRATION_HOURS=1

GIT_CREATE_DEPLOY_KEY=true
GIT_REPO=git@github.com:your-org/your-manifest-repo.git
GIT_BRANCH=main
GIT_POLLING_INTERVAL=5

# --- Database ---
# Point these at your own Postgres (e.g. RDS) and remove the "postgres" service
# from docker-compose.yml to skip the bundled container entirely.
DB_HOST=postgres
DB_PORT=5432
DB_USER=shogun
DB_PASSWORD=pwd
DB_NAME=shogun_db
DB_SSL_MODE=disable
DB_MASTER_KEY=change-me
DB_ENCRYPTION_SALT=change-me

# --- UI (optional, requires the `ui` profile) ---
SHOGUN_UI_IMAGE=ghcr.io/sdslabs/shogun-ui:latest
SHOGUN_UI_PORT=8080
